{
  // Type-checks the Playwright suite (run by `npm run typecheck`). The specs
  // import PlayerState and protocol types from src/, so the player's ambient
  // declarations (Strudel globals, Vite client) are included too.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts",
    "../src/vite-env.d.ts",
    "../src/strudel.d.ts",
    "../src/strudel.generated.d.ts",
    "../src/strudel.sounds.generated.d.ts"
  ]
}
